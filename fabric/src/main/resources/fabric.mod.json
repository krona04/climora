  "authors": [
    "Krona04"
  ],
  "contact": {
    "homepage": ""
  },
  "license": "MIT",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.krona.climora.fabric.ClimoraFabric"
    ],
    "client": [
      "net.krona.climora.fabric.client.ClimoraFabricClient"
    ]
  },
  "mixins": [
    "climora.mixins.json"
  ],
  "accessWidener": "climora.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "architectury": ">=13.0.11",
    "fabric-api": "*"
